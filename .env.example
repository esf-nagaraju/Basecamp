# Session Configuration (REQUIRED)
SESSION_SECRET=your-random-session-secret-here

# Azure AD Authentication (OPTIONAL - leave blank to use admin-only mode)
# Get these values from Azure Portal > App Registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Local Admin Account (for emergency/initial access)
# ⚠️ CHANGE THESE IN PRODUCTION! Default: admin / admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# Application URL (required for OAuth redirects)
# For local development:
# APP_URL=http://localhost:5000
# For Azure deployment:
# APP_URL=https://your-app-name.azurewebsites.net
APP_URL=http://localhost:5000

# Database Connection
DATABASE_URL=postgresql://username:password@hostname:port/database

# Session Configuration
SESSION_SECRET=your-random-session-secret-here

# Server Configuration
NODE_ENV=development
PORT=5000

# Optional: Set to 'production' for production builds
# NODE_ENV=production
